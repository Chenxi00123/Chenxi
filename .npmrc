# ADR-012 / 05-工程规范 §1 供应链硬化
# 直接外部依赖钉死精确版本
save-exact=true
# 统一禁止生命周期脚本（安装脚本需显式白名单，见 05 §1）
ignore-scripts=true
# 冷启动保护：不采用刚发布的依赖版本
# 注：npm 不支持 min-release-age（该能力属 pnpm/yarn），此处以注释登记约束；
# 依赖升级必须在 PR 中人工核验发布时间（>= 2 天）。
package-lock=true
engine-strict=true

# Phase 1 本机约束：禁止写入 C 盘 —— npm/npx 缓存重定向到 D 盘工作区
# （本机专用；开源前须移除本行或改为环境变量传入）
cache=d:/Desktop/agents/.dev/npm-cache
