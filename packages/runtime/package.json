{
  "name": "@aster/runtime",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Aster runtime: kernel modules, CLI and extension seams.",
  "license": "Apache-2.0",
  "engines": { "node": ">=22.19" },
  "main": "./dist/index.js",
